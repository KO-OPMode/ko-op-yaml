{
  "name": "ko-op-yaml",
  "displayName": "ko-op-yaml",
  "description": "",
  "version": "1.1.0",
  "publisher": "koop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KO-OPMode/ko-op-yaml.git"
  },
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:yml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "[yaml]": {
        "editor.inlineSuggest.enabled": true
      }
    },
    "commands": [
      {
        "command": "ko-op-yaml.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "build": "mkdir -p build && vsce package --out build/"
  },
  "devDependencies": {
    "@types/vscode": "^1.116.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
